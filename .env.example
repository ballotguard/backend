# Server
SERVER_PORT=8080

# MongoDB
# For local MongoDB (application-dev.yml):
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE_NAME=ballotguard
MONGODB_AUTO_INDEX_CREATION=true
# For MongoDB Atlas / production (application-prod.yml):
MONGODB_URI=mongodb://localhost:27017/ballotguard

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_AUTH=true
MAIL_STARTTLS=true

# Google OAuth2 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Security & JWT (at least 32 characters / 256 bits)
JWT_KEY=your-jwt-secret-key-must-be-at-least-32-chars-long!
REFRESH_TOKEN_KEY=your-refresh-token-secret-key-at-least-32-chars!

# CORS
CORS_ALLOWED_ORIGIN_1=http://localhost:3000

# Voting Link Security
VOTING_LINK_STRING_SECRET=your-secure-voting-link-secret-key-here
VOTING_LINK_ALGO=HmacSHA256
